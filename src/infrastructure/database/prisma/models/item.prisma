model Item {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  weightKg  Decimal @db.Decimal(10, 3)
  lengthCm  Decimal @db.Decimal(10, 2)
  widthCm   Decimal @db.Decimal(10, 2)
  heightCm  Decimal @db.Decimal(10, 2)

  @@map("items")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  // Ordem de insercao garantida pelo banco: createdAt pode empatar (mesmo
  // milissegundo) e nao ordena eventos do mesmo agregado de forma estavel.
  sequence    BigInt    @default(autoincrement()) @unique
  aggregateId String
  eventType     String
  schemaVersion Int
  correlationId String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt])
  @@map("outbox_events")
}