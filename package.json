{
  "name": "ms-catalog",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "prebuild": "mkdir -p dist/src/infrastructure/database/generated && cp -r src/infrastructure/database/generated/. dist/src/infrastructure/database/generated/",
    "build": "nest build",
    "prestart": "mkdir -p dist/src/infrastructure/database/generated && cp -r src/infrastructure/database/generated/. dist/src/infrastructure/database/generated/",
    "start": "nest start",
    "prestart:dev": "mkdir -p dist/src/infrastructure/database/generated && cp -r src/infrastructure/database/generated/. dist/src/infrastructure/database/generated/",
    "start:dev": "nest start --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "patch-package": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "postinstall-postinstall": "^2.1.0",
    "prisma": "^7.9.1",
    "typescript": "^5.5.4"
  }
}
