# Obrigatorias
DATABASE_URL=postgresql://catalog:catalog@localhost:5433/catalog_db?schema=public
KAFKA_BROKER=localhost:9092

# Opcionais (valores padrao)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
KAFKA_CLIENT_ID=ms-catalog
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_CREATE_ITEM_TTL_MS=60000
THROTTLE_CREATE_ITEM_LIMIT=20
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_MS=30000
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
